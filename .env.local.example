# ========================================
# Supabase 配置
# 本地开发可直接沿用 `npx supabase start` 输出的 URL 与 Key
# ========================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================================
# Cloudflare R2 / CDN 配置（必填）
# ========================================
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_PUBLIC_BUCKET=rixing-public
R2_PRIVATE_BUCKET=rixing-private
R2_PUBLIC_URL=https://cdn.example.com/public
CDN_PUBLIC_URL=https://cdn.example.com

# ========================================
# 阿里云 OCR 配置（AI题库配图裁剪功能）
# ========================================
# 获取方式: https://ram.console.aliyun.com/manage/ak
# 免费额度: 5,000次/月
# 推荐地域: cn-hangzhou (华东1-杭州)
# 服务地址: ocr-api.cn-hangzhou.aliyuncs.com
# API 接口: recognizeCharacterAdvance
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
OCR_REGION=cn-hangzhou

# ========================================
# LiveKit 配置（本地可使用 docker-compose.livekit.yml）
# ========================================
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ========================================
# Cron 任务校验密钥
# ========================================
CRON_SECRET=your-random-secret-key-min-32-chars

# ========================================
# Gemini Vision (Google Generative AI)
# ========================================
GEMINI_API_KEY=sk-dKspwCRKaJVO0myz81inyBr4o33fuMWgxyGiR5ZFj0mmlpyv
GEMINI_BASE_URL=https://api.ikuncode.cc
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT=120000
# Prompt版本 (v1|v2)
GEMINI_PROMPT_VERSION=v2

# ========================================
# 运行模式
# ========================================
NODE_ENV=development

# ========================================
# OpenCV 精修参数（Pipeline）
# ========================================
# 膨胀核尺寸 (宽,高)
OPENCV_KERNEL_SIZE=15,10
# 膨胀迭代次数
OPENCV_KERNEL_ITERATIONS=1
# IoU 质检阈值 (0-1)，低于阈值回退粗框
OPENCV_IOU_THRESHOLD=0.3
BINARY_STRATEGY=otsu
ENABLE_QUALITY_SCORE=false
ANCHOR_VERIFY_ENABLED=false
ANCHOR_VERIFY_MIN_LENGTH=5
# 旧 0-100 坐标自动放大到 0-1000（慎用，默认关闭）
AUTO_SCALE_LEGACY_BOX=false

# ========================================
# DeepSeek API 配置（AI数学题创作）
# ========================================
# 获取方式: https://platform.deepseek.com/api_keys
# 免费额度: 500万 tokens
# 模型选择:
#   - deepseek-chat: 对话模式（快速）
#   - deepseek-reasoner: 推理模式（更强的逻辑推理能力，推荐用于数学题生成）
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_REQUEST_TIMEOUT=60000
DEEPSEEK_MAX_RETRIES=2

# ========================================
# E2B Sandbox 配置（Python代码安全执行）
# ========================================
# 获取方式: https://e2b.dev/docs
# 免费额度: 100小时/月
# 注意: E2B Code Interpreter 默认包含 matplotlib, numpy, scipy 等库
#      不需要指定 E2B_TEMPLATE，留空即可使用默认环境
E2B_API_KEY=e2b_xxxxx
# E2B_TEMPLATE=  # 留空使用默认环境，或指定自定义模板ID
E2B_TIMEOUT_MS=15000
E2B_CPU_LIMIT=1
E2B_MEMORY_LIMIT_MB=512
E2B_DISK_LIMIT_MB=100

# ========================================
# AI创作功能配置
# ========================================
# 默认每日生成限额（每用户）
AI_CREATOR_DEFAULT_DAILY_LIMIT=20
# 并发任务限制（每用户）
AI_CREATOR_CONCURRENT_LIMIT=2
# 速率限制（每分钟请求数）
AI_CREATOR_RATE_LIMIT_PER_MINUTE=5
# 最大重试次数
AI_CREATOR_MAX_RETRIES=2
# 是否启用SVG输出
AI_CREATOR_ENABLE_SVG=true
# 重试是否扣除配额
AI_CREATOR_RETRY_DEDUCT_QUOTA=false

# ========================================
# 功能开关（分阶段启用）
# ========================================
# Week 5-6: Manim几何图形支持
ENABLE_MANIM=false
# Week 7-8: Gemini Vision改编功能
ENABLE_VISION_ADAPTATION=false
# Week 9-10: 自动清理Cron任务
ENABLE_CLEANUP_CRON=true

# ========================================
# 监控告警配置（可选）
# ========================================
# Slack Webhook (用于告警通知)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# 告警邮箱
ALERT_EMAIL=admin@example.com
# Grafana推送地址（可选）
GRAFANA_PUSH_URL=https://grafana.example.com/api/push
# 日志推送地址（可选，Loki/CloudWatch等）
LOG_ENDPOINT=https://loki.example.com/loki/api/v1/push
