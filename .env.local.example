# ========================================
# Supabase 配置
# ========================================
# 如果使用 `npx supabase start`，保持默认端口即可使用以下本地值
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ========================================
# Cloudflare R2 对象存储配置
# ========================================
# 请在 Cloudflare Dashboard → R2 创建存储桶后，生成 API 令牌
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_PUBLIC_BUCKET=rixing-public
R2_PRIVATE_BUCKET=rixing-private
R2_PUBLIC_URL=https://your-bucket.r2.dev
CDN_PUBLIC_URL=https://cdn.rixing.com

# ========================================
# 七牛云 CDN 配置（可选）
# ========================================
# 用于国内访问加速
QINIU_ACCESS_KEY=your-qiniu-access-key
QINIU_SECRET_KEY=your-qiniu-secret-key
QINIU_BUCKET=rixing-cdn
QINIU_DOMAIN=cdn.rixing.com

# ========================================
# 钉钉告警配置（可选）
# ========================================
# 用于队列积压、Worker 崩溃等告警
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-token

# ========================================
# Redis 配置（用于 BullMQ 队列）
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# 开发环境配置
# ========================================
NODE_ENV=development
