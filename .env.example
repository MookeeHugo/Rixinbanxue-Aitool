# ========================================
# 日新平台环境变量配置示例
# ========================================
# 复制此文件为 .env.local 并填入真实的配置值
# 请勿将包含真实密钥的文件提交到 git

# ========================================
# Supabase 配置（必需）
# ========================================
# 获取方式：https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================================
# Cloudflare R2 存储配置（必需）
# ========================================
# 获取方式：Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_PUBLIC_BUCKET=your_public_bucket_name
R2_PRIVATE_BUCKET=your_private_bucket_name
R2_PUBLIC_URL=https://your-r2-public-url.com
CDN_PUBLIC_URL=https://your-cdn-domain.com

# ========================================
# AI 服务配置（可选）
# ========================================

# Google Gemini API
# 获取方式：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API
# 获取方式：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ========================================
# OCR 服务配置（可选）
# ========================================

# 阿里云 OCR
# 获取方式：阿里云控制台 → AccessKey 管理
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here
OCR_REGION=cn-hangzhou
