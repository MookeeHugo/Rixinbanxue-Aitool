/**
 * AI 题库系统 - Prompt 模板
 * @description Qwen3-VL-Flash 的系统与用户提示词，统一 JSON 输出
 */

/**
 * System Prompt：定义 AI 角色与能力
 */
export const QWEN_SYSTEM_PROMPT = `
你是一名专业的数学试卷结构化工程师，需要将整页图像转换为严格 JSON。
1. **题干抽取**：完整读取题号、文本、公式，并把所有数学表达式转换为 LaTeX。
2. **选项标准化**：单选/多选题的每个选项必须用 $...$ 包裹，禁止混入 Markdown。
3. **配图定位**：识别题目中出现的每张图，使用占位符 \`<<IMG_{题号}_{序号}>>\` 并在 JSON 的 \`images\` 字段中描述。
4. **结构要求**：输出必须符合给定 schema，不要附加任何解释或多余字段。

注意事项：
- JSON 顶层对象要可以直接 JSON.parse。
- 所有文本统一 UTF-8，保留题号顺序，不要跳号。
- 当题干引用配图时，在 content 中保留 placeholder，并在 \`images\` 中填写 placeholder/description/position。
- \`type\` 字段仅允许 choice/fill/essay/proof。
- 如有无法识别的区域，请在 description 中说明原因，保持结构完整。
`;

/**
 * User Prompt：具体任务指令
 */
export const QWEN_USER_PROMPT = `
请阅读整张试卷图片，并按照以下 JSON schema 返回识别结果：
\`\`\`json
{
  "questions": [
    {
      "number": "题号（字符串）",
      "type": "choice|fill|essay|proof",
      "content": "题干内容，包含 LaTeX 公式与占位图 <<IMG_题号_序号>>",
      "options": ["A. $...$", "B. $...$"],
      "answer": "可选，若未给出请返回 null",
      "images": [
        {
          "placeholder": "<<IMG_1_1>>",
          "description": "配图描述",
          "position": "left|right|bottom|inline"
        }
      ],
      "meta": {
        "knowledge": ["对应知识点"],
        "difficulty": "easy|medium|hard"
      },
      "confidence": 0.0 - 1.0,
      "steps": ["可选，推理步骤"]
    }
  ]
}
\`\`\`

请确保：
- `number` 从图片原题号读取，若缺失可生成 "Q1" 类似占位。
- `content` 中的数学公式均转为 LaTeX，普通文字保持原文。
- 所有图片在 `images` 中列出，并与题干 placeholder 对应。
- 输出必须是合法 JSON 字符串，不要包含 Markdown 三引号以外的解释。
`;

/**
 * 获取完整 Prompt，支持 Base64 或图像 URL
 */
type PromptImageInput =
  | string
  | {
      base64?: string | null;
      mimeType?: string;
      imageUrl?: string;
    };

export function getQwenPromptMessages(
  image: PromptImageInput,
  fallbackMimeType: string = 'image/jpeg'
) {
  let base64Value: string | undefined;
  let mimeType = fallbackMimeType;
  let imageUrl: string | undefined;

  if (typeof image === 'string') {
    base64Value = image;
  } else {
    base64Value = image.base64 ?? undefined;
    mimeType = image.mimeType || fallbackMimeType;
    imageUrl = image.imageUrl ?? undefined;
  }

  if (!imageUrl && !base64Value) {
    throw new Error('必须提供 Base64 编码或图像 URL');
  }

  const imageContent = imageUrl
    ? { type: 'image_url', image_url: { url: imageUrl } }
    : {
        type: 'image_url',
        image_url: { url: `data:${mimeType};base64,${base64Value}` }
      };

  return [
    {
      role: 'system',
      content: [{ type: 'text', text: QWEN_SYSTEM_PROMPT }]
    },
    {
      role: 'user',
      content: [
        { type: 'text', text: QWEN_USER_PROMPT },
        imageContent
      ]
    }
  ];
}

/**
 * 置信度回查 Prompt（当 confidence < 0.8 时触发）
 */
export const QWEN_RECHECK_PROMPT = `
请仔细复核以下题目的识别结果，重点检查：
1. 数学公式是否完整无缺；
2. 选项编号是否正确；
3. 答案与配图描述是否一致。

若发现错误，请修正并更新 confidence；
若确认无误，请保持原结果并在理由中说明。

上一次识别输出：
{{PREVIOUS_RESULT}}

请返回修订后的完整 JSON。`;
